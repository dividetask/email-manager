# Email Daemon Configuration

# Email server settings
email:
  host: imap.gmail.com              # Your IMAP server
  port: 993
  username: your-email@gmail.com     # YOUR EMAIL HERE
  password: your-app-password        # YOUR PASSWORD HERE
  ssl: true
  mailbox: INBOX

# Storage settings
email_storage_dir: ./data/emails
database_path: ./data/emails.json

# Daemon settings
check_interval: 3600  # Check every hour (in seconds)

# Logging
log_path: ./logs/email_daemon.log
